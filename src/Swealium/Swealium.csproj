<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Swealium</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>A retained-mode GUI framework foundation using SDL3 and SkiaSharp.</Description>
    <PackageTags>gui;skia;sdl3;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="Topten.RichTextKit" Version="0.6.173" />
    <PackageReference Include="AngleSharp" Version="1.10.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/**/*" Pack="true" PackagePath="docs/" />
    <InternalsVisibleTo Include="Swealium.Tests" />
  </ItemGroup>

</Project>
